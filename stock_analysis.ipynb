# -*- coding: utf-8 -*-
# A股股票数据分析与可视化 （和截图完全对应）
import requests
import csv
import pandas as pd
import numpy as np
from pyecharts.charts import Bar,Pie,Line
from pyecharts import options as opts

# ==========1、爬虫采集股票数据==========
url = "http://push2.eastmoney.com/api/qt/clist/get"
params = {
    "pn": "1",
    "pz": "50",
    "po": "1",
    "np": "1",
    "ut": "bd1d9ddb04089700cf9c27f6f2742621",
    "fltt": "2",
    "invt": "2",
    "fid": "f20",
    "fs": "m:0 t:6,m:0 t:13,m:0 t:80,m:1 t:2,m:1 t:23",
    "fields": "f1,f2,f3,f4,f5,f6,f7,f12,f14,f20"
}
headers = {
    "User-Agent":"Mozilla/5.0"
}
res = requests.get(url,params=params,headers=headers)
json_data = res.json()
data_list = json_data["data"]["diff"]

# 写入csv
with open("stock.csv","w",encoding="utf-8",newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["股票代码","股票名称","当前价","涨跌幅","涨跌额","成交量","成交额","换手率","市净率"])
    for data in data_list:
        row = [data["f12"],data["f14"],data["f2"],data["f3"],data["f4"],data["f5"],data["f6"],data["f7"],data["f20"]]
        writer.writerow(row)

# ==========2、Pandas数据预处理==========
df = pd.read_csv("stock.csv",encoding="utf-8")
# 缺失值检测
print("缺失值统计：")
print(df.isnull().sum())
# 缺失值填充
df = df.fillna(0)
# 按成交量降序排序
df_sort = df.sort_values(by="成交量",ascending=False)
print("成交量排序后：")
print(df_sort.head(10))

# ==========3、Pyecharts 成交量柱状图==========
bar = (
    Bar()
    .add_xaxis(df_sort["股票名称"].head(10).tolist())
    .add_yaxis("成交量",df_sort["成交量"].head(10).tolist())
    .set_global_opts(title_opts=opts.TitleOpts(title="股票成交量排行柱状图"))
)
bar.render("成交量柱状图.html")

# ==========4、市值饼图==========
pie = (
    Pie()
    .add("",list(zip(df_sort["股票名称"].head(8),df_sort["市净率"].head(8))))
    .set_global_opts(title_opts=opts.TitleOpts(title="股票市净率占比饼图"))
)
pie.render("市值饼图.html")

# ==========5、涨跌幅折线图==========
line = (
    Line()
    .add_xaxis(df_sort["股票名称"].head(10).tolist())
    .add_yaxis("涨跌幅",df_sort["涨跌幅"].head(10).tolist())
    .set_global_opts(title_opts=opts.TitleOpts(title="股票涨跌幅折线图"))
)
line.render("涨跌幅折线图.html")
print("全部交互式图表生成完毕")
